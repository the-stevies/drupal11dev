<div class="layout-container">

  <header role="banner" class="topheader">
    {{ page.header }}
    {{ page.primary_menu }}
  </header>

  {{ page.breadcrumb }}

  <main role="main">
    <a id="main-content" tabindex="-1"></a>

    {{ page.highlighted }}
    {{ page.help }}

    <div class="layout-content">
      {{ page.content }}
    </div>

    {{ page.sidebar_first }}
    {{ page.sidebar_second }}
  </main>

  <footer role="contentinfo">
    <div class="footer-inner">
      {{ page.footer }}
    </div>
  </footer>

</div>
