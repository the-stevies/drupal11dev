<div class="layout-container">

  <header role="banner">
    {{ page.header }}
    {{ page.primary_menu }}
  </header>

  {{ page.breadcrumb }}

  <main role="main">
    <a id="main-content" tabindex="-1"></a>



    {{ page.highlighted }}
    {{ page.help }}

    <div class="layout-content">
        <div class="pattern one">
          <div class="pattern-inner">
            <h1>See Drupal in Action Across Industries</h1>
            <p>
            From Fortune 500 enterprises to innovative startups, organizations across every industry choose Drupal <br>for digital experiences that scale. Explore industry-specific pages showcasing real projects, proven results, <br>and the exact challenges Drupal solves in your sector.</p>
          </div>
        </div>
        <div class="pattern-two">
          <div class="pattern-inner">
            <h1>User-centric experiences</h1>
            <p>
            Create compelling content across more devices than ever with tools that build versatile, structured content and integrate seamlessly with a wide range of digital marketing channels.</p>
          </div>
        </div>

    </div>

    {{ page.sidebar_first }}
    {{ page.sidebar_second }}
  </main>

  <footer role="contentinfo">
    {{ page.footer }}
  </footer>

</div>
