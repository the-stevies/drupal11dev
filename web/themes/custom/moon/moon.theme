<?php

use Drupal\Component\Utility\Xss;
use Drupal\Core\Template\RenderWrapper;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Theme\ThemeSettings;
use Drupal\Component\Utility\Html;
use Drupal\user\UserInterface;
use Drupal\node\NodeInterface;



/**
 * Implements hook_preprocess_block().
 */
function moon_preprocess_block(&$variables) {

  $variables['base_path'] = base_path();
}



/**
 * Preprocess variables for html templates.
 * @param $variables
 */
function moon_preprocess_html(&$variables) {
  $variables['path_info']['args'] = FALSE;
  $path = \Drupal::request()->getPathInfo();
  $path_args = explode('/', $path);
  if (count($path_args) >= 3) {
    $variables['path_info']['args'] = Html::cleanCssIdentifier(ltrim($path, '/'));
  }
  

  $route_match = \Drupal::routeMatch();
    $route_name = $route_match->getRouteName();

    // 1. Routenname: route-entity-node-canonical, route-user-login, ...
    if ($route_name) {
      $variables['attributes']['class'][] = 'route-' . str_replace(['.', '_'], '-', $route_name);
    }

    // 2. Node-ID und Inhaltstyp.
    $node = $route_match->getParameter('node');
    if ($node instanceof NodeInterface) {
      $variables['attributes']['class'][] = 'node-id-' . $node->id();
      $variables['attributes']['class'][] = 'node-type-' . $node->bundle();
    }

    // 3. Alias-Pfad als Klasse: /ueber-mich -> path-ueber-mich
    $alias = trim(\Drupal::service('path.current')->getPath(), '/');
    $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/' . $alias);
    $slug = trim(preg_replace('/[^a-z0-9]+/', '-', strtolower($alias)), '-');
    $variables['attributes']['class'][] = $slug ? 'path-' . $slug : 'path-front';

    // Cache-Kontexte, sonst gelten die Klassen der ersten gecachten Seite überall.
    $variables['#cache']['contexts'][] = 'route';
    $variables['#cache']['contexts'][] = 'url.path';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function moon_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $suggestions[] = 'page__' . $node->bundle();
  }
}

function moon_preprocess_page(&$vars) {

  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;
}

function moon_preprocess_node(&$variables) {
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['language'] = $language;
}

function moon_preprocess_user(array &$variables): void {
  /** @var \Drupal\user\UserInterface $account */
  $account = $variables['elements']['#user'];

  $variables['is_own_profile'] = (int) \Drupal::currentUser()->id() === (int) $account->id();
  $variables['last_login'] = $account->getLastLoginTime() ?: NULL;

  // Ausgabe hängt vom angemeldeten Nutzer ab.
  $variables['#cache']['contexts'][] = 'user';
}
